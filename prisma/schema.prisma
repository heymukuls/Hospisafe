generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum StaffRole {
  ADMIN
  SUPERVISOR
  STAFF
}

enum AreaType {
  ROOM
  WASHROOM
  LOBBY
  BED
  OTHER
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

model Hospital {
  id          String       @id @default(cuid())
  name        String
  floors      Floor[]
  departments Department[]
  areas       Area[]
  staff       Staff[]
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Floor {
  id          String       @id @default(cuid())
  name        String
  hospitalId  String
  hospital    Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departments Department[]
  areas       Area[]
  staff       Staff[]
  tasks       Task[]
  createdAt   DateTime     @default(now())

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model Department {
  id         String   @id @default(cuid())
  name       String
  hospitalId String
  floorId    String?
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  floor      Floor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  areas      Area[]
  staff      Staff[]
  tasks      Task[]
  createdAt  DateTime @default(now())

  @@unique([hospitalId, name])
  @@index([floorId])
}

model Area {
  id           String      @id @default(cuid())
  name         String
  type         AreaType    @default(OTHER)
  hospitalId   String
  floorId      String?
  departmentId String?
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  floor        Floor?      @relation(fields: [floorId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks        Task[]
  createdAt    DateTime    @default(now())

  @@index([hospitalId])
  @@index([floorId])
  @@index([departmentId])
}

model Staff {
  id             String          @id @default(cuid())
  employeeId     String
  name           String
  phone          String?
  photoUrl       String?
  role           StaffRole       @default(STAFF)
  isActive       Boolean         @default(true)
  hospitalId     String
  floorId        String?
  departmentId   String?
  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  floor          Floor?          @relation(fields: [floorId], references: [id], onDelete: SetNull)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTasks  Task[]          @relation("AssignedTasks")
  createdTasks   Task[]          @relation("CreatedTasks")
  verifiedTasks  Task[]          @relation("VerifiedTasks")
  checklistItems ChecklistItem[] @relation("ChecklistCompletedBy")
  activities     TaskActivity[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([hospitalId, employeeId])
  @@index([hospitalId, role])
  @@index([floorId])
  @@index([departmentId])
}

model Task {
  id           String          @id @default(cuid())
  title        String
  description  String?         @db.Text
  priority     TaskPriority    @default(MEDIUM)
  status       TaskStatus      @default(ASSIGNED)
  dueAt        DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  verifiedAt   DateTime?
  hospitalId   String
  floorId      String?
  departmentId String?
  areaId       String?
  assignedToId String?
  createdById  String
  verifiedById String?
  hospital     Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  floor        Floor?          @relation(fields: [floorId], references: [id], onDelete: SetNull)
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  area         Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignedTo   Staff?          @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    Staff           @relation("CreatedTasks", fields: [createdById], references: [id])
  verifiedBy   Staff?          @relation("VerifiedTasks", fields: [verifiedById], references: [id], onDelete: SetNull)
  checklist    ChecklistItem[]
  activities   TaskActivity[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([hospitalId, status])
  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([areaId])
}

model ChecklistItem {
  id            String    @id @default(cuid())
  title         String
  position      Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  taskId        String
  completedById String?
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy   Staff?    @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([taskId, position])
}

model TaskActivity {
  id        String   @id @default(cuid())
  action    String
  note      String?  @db.Text
  taskId    String
  actorId   String?
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     Staff?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
}
